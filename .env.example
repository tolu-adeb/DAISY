# ABG Intelligence Terminal - configuration
# Copy to `.env` in the folder you run `abg` from. Every setting is optional.
# Full reference: docs/07-operations.md

# ---- Data provider API keys (free tiers are fine; each one adds a failover source)
ABG_POLYGON_API_KEY=
ABG_TIINGO_API_KEY=
ABG_FMP_API_KEY=
ABG_TWELVEDATA_API_KEY=
ABG_ALPHAVANTAGE_API_KEY=
ABG_FINNHUB_API_KEY=

# ---- Claude AI insight (optional; rule-based insight is used without it)
ANTHROPIC_API_KEY=
# ABG_ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Provider priority AND allow-list (providers not listed are never used automatically)
# ABG_PROVIDER_ORDER=yahoo,polygon,tiingo,fmp,twelvedata,alphavantage,finnhub,yfinance,stooq,csv,synthetic
# ABG_DISABLED_PROVIDERS=

# ---- Optional per-capability order (priority + allow-list for that one capability)
# ABG_QUOTE_ORDER=finnhub,twelvedata,tiingo,yahoo,yfinance
# ABG_HISTORY_ORDER=tiingo,twelvedata,yahoo,yfinance,stooq,csv
# ABG_NEWS_ORDER=finnhub,yahoo,yfinance
# ABG_FUNDAMENTALS_ORDER=finnhub,yahoo,yfinance,tiingo
# ABG_OPTIONS_ORDER=yahoo,yfinance
# ABG_TIINGO_NEWS_ENABLED=false        # true only if your Tiingo plan includes the News API
# ABG_CSV_DIR=./data

# ---- Latency / resilience
# ABG_HTTP_TIMEOUT=8
# ABG_HEDGE_DELAY=1.5
# ABG_MAX_RETRIES=1
# ABG_BREAKER_FAILURES=3
# ABG_BREAKER_COOLDOWN=60

# ---- Cache (seconds)
# ABG_CACHE_DIR=~/.cache/abg-terminal
# ABG_TTL_QUOTE=15
# ABG_TTL_HISTORY_DAILY=900
# ABG_MAX_STALE=604800

# ---- Analysis
# ABG_RISK_FREE_RATE=0.04
# ABG_BENCHMARK=SPY

# ---- Extra risk models (module:Class, comma separated)
# ABG_RISK_MODELS=examples.custom_risk_model:VolTargetRiskModel

# ---- Demo mode: simulated prices when no real source answers (clearly flagged)
# ABG_ALLOW_SYNTHETIC=false

# ---- Saved portfolio + live monitor (docs/09-portfolio-and-live-signals.md)
# ABG_DATA_DIR=data                        # where portfolio.sqlite3 lives (default ~/.abg-terminal)
# ABG_MONITOR_ON_SERVE=true
# ABG_MONITOR_QUOTE_INTERVAL=60
# ABG_MONITOR_ANALYSIS_INTERVAL=900
# ABG_SIGNAL_COOLDOWN=14400
# ABG_PRICE_MOVE_PCT=3
# ABG_POSITION_LOSS_PCT=8

# ---- Alerts
# ABG_NOTIFY_DESKTOP=true                  # needs: pip install plyer
# ABG_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# ABG_NOTIFY_DISCORD_MIN_SEVERITY=info
# ABG_SMTP_HOST=smtp.gmail.com
# ABG_SMTP_PORT=587
# ABG_SMTP_USER=you@gmail.com
# ABG_SMTP_PASSWORD=your-16-char-app-password
# ABG_EMAIL_TO=you@gmail.com
# ABG_NOTIFY_EMAIL_MIN_SEVERITY=warning

# ---- Prediction engine (docs/10-prediction.md)
# ABG_FORECAST_PATHS=5000
# ABG_FORECAST_HORIZON=63                  # trading days (21=1m, 63=3m, 126=6m, 252=1y)
# ABG_FORECAST_EQUITY_PREMIUM=0.05
# ABG_FORECAST_SIGNAL_TILT=0.25
