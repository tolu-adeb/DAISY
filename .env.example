# ABG Intelligence Terminal - configuration
# Copy to `.env` in the folder you run `abg` from. Every setting is optional.
# Full reference: docs/07-operations.md

# ---- Data provider API keys (free tiers are fine; each one adds a failover source)
ABG_POLYGON_API_KEY=
ABG_TIINGO_API_KEY=
ABG_FMP_API_KEY=
ABG_TWELVEDATA_API_KEY=
ABG_ALPHAVANTAGE_API_KEY=
ABG_FINNHUB_API_KEY=

# ---- Claude AI insight (optional; rule-based insight is used without it)
ANTHROPIC_API_KEY=
# ABG_ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Provider priority AND allow-list (providers not listed are never used automatically)
# ABG_PROVIDER_ORDER=yahoo,polygon,tiingo,fmp,twelvedata,alphavantage,finnhub,yfinance,stooq,csv,synthetic
# ABG_DISABLED_PROVIDERS=

# ---- Optional per-capability order (priority + allow-list for that one capability)
# ABG_QUOTE_ORDER=finnhub,twelvedata,tiingo,yahoo,yfinance
# ABG_HISTORY_ORDER=tiingo,twelvedata,yahoo,yfinance,stooq,csv
# ABG_NEWS_ORDER=finnhub,yahoo,yfinance
# ABG_FUNDAMENTALS_ORDER=finnhub,yahoo,yfinance,tiingo
# ABG_OPTIONS_ORDER=yahoo,yfinance
# ABG_TIINGO_NEWS_ENABLED=false        # true only if your Tiingo plan includes the News API
# ABG_CSV_DIR=./data

# ---- Latency / resilience
# ABG_HTTP_TIMEOUT=8
# ABG_HEDGE_DELAY=1.5
# ABG_MAX_RETRIES=1
# ABG_BREAKER_FAILURES=3
# ABG_BREAKER_COOLDOWN=60

# ---- Cache (seconds)
# ABG_CACHE_DIR=~/.cache/abg-terminal
# ABG_TTL_QUOTE=15
# ABG_TTL_HISTORY_DAILY=900
# ABG_MAX_STALE=604800

# ---- Analysis
# ABG_RISK_FREE_RATE=0.04
# ABG_BENCHMARK=SPY

# ---- Extra risk models (module:Class, comma separated)
# ABG_RISK_MODELS=examples.custom_risk_model:VolTargetRiskModel

# ---- Demo mode: simulated prices when no real source answers (clearly flagged)
# ABG_ALLOW_SYNTHETIC=false

# ---- Saved portfolio + live monitor (docs/09-portfolio-and-live-signals.md)
# ABG_DATA_DIR=data                        # where portfolio.sqlite3 lives (default ~/.abg-terminal)
# ABG_MONITOR_ON_SERVE=true
# ABG_MONITOR_QUOTE_INTERVAL=60
# ABG_MONITOR_ANALYSIS_INTERVAL=900
# ABG_SIGNAL_COOLDOWN=14400
# ABG_PRICE_MOVE_PCT=3
# ABG_POSITION_LOSS_PCT=8

# ---- Alerts
# ABG_NOTIFY_DESKTOP=true                  # needs: pip install plyer
# ABG_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# ABG_NOTIFY_DISCORD_MIN_SEVERITY=info
# ABG_SMTP_HOST=smtp.gmail.com
# ABG_SMTP_PORT=587
# ABG_SMTP_USER=you@gmail.com
# ABG_SMTP_PASSWORD=your-16-char-app-password
# ABG_EMAIL_TO=you@gmail.com
# ABG_NOTIFY_EMAIL_MIN_SEVERITY=warning

# ---- Prediction engine (docs/10-prediction.md)
# ABG_FORECAST_PATHS=5000
# ABG_FORECAST_HORIZON=63                  # trading days (21=1m, 63=3m, 126=6m, 252=1y)
# ABG_FORECAST_EQUITY_PREMIUM=0.05
# ABG_FORECAST_SIGNAL_TILT=0.25

# ---- External signals (docs/11-external-signals.md)
# ABG_EXT_ENABLED=true
# ABG_DISCORD_BOT_TOKEN=                   # a BOT token (Developer Portal -> Bot); enable "Message Content Intent"
# ABG_EXT_DISCORD_CHANNEL_IDS=             # comma-separated channel ids to read signals from
# ABG_EXT_POLL_SECONDS=20
# ABG_EXT_BACKFILL_MESSAGES=0
# ABG_EXT_RELAY_MODE=webhook               # webhook | reply | none
# ABG_EXT_RELAY_WEBHOOK_URL=               # webhook in the signals channel (falls back to ABG_DISCORD_WEBHOOK_URL)
# ABG_EXT_RELAY_ACK=true
# ABG_EXT_RELAY_KINDS=                     # e.g. entry,target_hit,stop_hit,exit,advisory (empty = all)
# ABG_EXT_ACCOUNT_SIZE=10000
# ABG_EXT_RISK_PCT=1.0
# ABG_EXT_ENTRY_EXPIRY_DAYS=45
# ABG_EXT_MAX_HOLD_DAYS=90
# ABG_EXT_APPROACH_PCT=1.5
# ABG_EXT_MIN_ENTRY_GRADE=C                # A | B | C | D | none
# ABG_EXT_MOVE_STOP_TO_BREAKEVEN=true
# ABG_EXT_SCALE_IN=true                    # zones: 50% at the edge, 50% at the midpoint
# ABG_EXT_SCALE_IN_SPLIT=0.5
# ABG_EXT_SCALE_OUT=true                   # one far target: add a partial exit before it
# ABG_EXT_SCALE_OUT_MIN_R=1.5
# ABG_EXT_EARNINGS_WARN_DAYS=5
# ABG_EXT_EARNINGS_BLACKOUT_DAYS=1

# ---- Portfolio-level risk across tracked ideas (docs/12 §12.5)
# ABG_EXT_MAX_OPEN_POSITIONS=8
# ABG_EXT_MAX_HEAT_PCT=6
# ABG_EXT_MAX_CORRELATED=2
# ABG_EXT_MAX_SECTOR=3

# ---- Prop-firm / funded account guardrails (use your firm's exact numbers)
# ABG_PROP_ENABLED=false
# ABG_PROP_ACCOUNT_SIZE=50000
# ABG_PROP_DAILY_LOSS_LIMIT=1000
# ABG_PROP_MAX_DRAWDOWN=2500
# ABG_PROP_DRAWDOWN_MODE=eod               # eod | intraday
# ABG_PROP_MAX_CONTRACTS=0                 # 0 = no cap

# ---- Real-time, calendar, confirmation, AI, charts (docs/12)
# ABG_EXT_REALTIME=true                    # Finnhub websocket (uses ABG_FINNHUB_API_KEY)
# ABG_EXT_FAST_POLL_SECONDS=15             # futures / yields
# ABG_EXT_EVENT_BLACKOUT_BEFORE_MIN=30
# ABG_EXT_EVENT_BLACKOUT_AFTER_MIN=15
# ABG_EXT_MARKET_FILTER=true
# ABG_EXT_AUTO_EARNINGS=true
# ABG_EXT_CONFIRM_TIMEFRAME=1h             # 1h | 15m | none
# ABG_EXT_CONFIRM_MAX_WAIT_HOURS=24
# ABG_EXT_AI_PARSE=true                    # needs ANTHROPIC_API_KEY
# ABG_EXT_AI_NARRATIVE=true
# ABG_EXT_RELAY_CHARTS=true
# ABG_EXT_GRADE_MODEL=auto                 # auto | learned | rules

# ---- Discord slash commands + scheduled posts
# ABG_DISCORD_COMMANDS=true
# ABG_DISCORD_ADMIN_IDS=                   # your Discord user id(s): only these can change ideas via /abg
# ABG_EXT_WEEKLY_RECAP=true
# ABG_EXT_WEEK_AHEAD=true

# ---- Operations (docs/13)
# ABG_ADMIN_TOKEN=                         # required for changes when set (setup-server.sh generates one)
# ABG_VIEW_TOKEN=                          # required even to view when set
# ABG_HEALTHCHECK_URL=                     # https://hc-ping.com/<uuid>
# ABG_BACKUP_HOUR=2
# ABG_BACKUP_KEEP=14
# ABG_BROKER=none                          # none | alpaca_paper
# ABG_ALPACA_KEY_ID=
# ABG_ALPACA_SECRET_KEY=
